# fal.ai MCP server (see .mcp.json)
# In Claude Code cloud sessions the key is supplied by the environment's
# API credential, which injects the Authorization header outside the VM --
# nothing to set here. For LOCAL use, set FAL_KEY and add the header back
# to .mcp.json:  "headers": { "Authorization": "Bearer ${FAL_KEY}" }
FAL_KEY=your_fal_api_key

# scroll-craft skill (.claude/skills/scroll-craft). Only needed when the skill
# GENERATES imagery/video via kie.ai; bring-your-own-assets builds skip it.
# Get a key at https://kie.ai
KIE_AI_API_KEY=your_kie_api_key
